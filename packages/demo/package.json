{
    "name": "@opus/miniapp-demo",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "description": "A page that shows every part of the OPUS mini-app kit, for looking at and for checking a change.",
    "scripts": {
        "dev": "next dev --port 3300",
        "build": "next build",
        "lint": "tsc -p tsconfig.json --noEmit",
        "formatting:check": "prettier 'app/**/*.{ts,tsx,css}' '*.{json,ts,mjs}' -c",
        "formatting:write": "prettier 'app/**/*.{ts,tsx,css}' '*.{json,ts,mjs}' --write"
    },
    "dependencies": {
        "@opus/miniapp": "*",
        "next": "^16.3.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^22.10.0",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "postcss": "^8.5.6",
        "prettier": "^2.8.8",
        "tailwindcss": "^4.3.3",
        "typescript": "5.9.3"
    }
}
