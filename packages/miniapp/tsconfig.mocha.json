{
    "compilerOptions": {
        "target": "es2020",
        "lib": ["dom", "esnext"],
        "module": "commonjs",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "skipLibCheck": true,
        "types": ["mocha", "node"]
    },
    "include": ["src/**/*", "test/**/*"]
}
