{
    "name": "@opus/miniapp",
    "version": "0.1.0",
    "description": "OPUS mini-app UI kit: the shell, the way back to the Portal, the wallet pill, the network warning and the design tokens every mini-app shares.",
    "license": "UNLICENSED",
    "sideEffects": [
        "*.css"
    ],
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./core": "./src/core/index.ts",
        "./tokens.css": "./src/tokens.css"
    },
    "files": [
        "src"
    ],
    "scripts": {
        "test": "TS_NODE_PROJECT=tsconfig.mocha.json mocha --require ts-node/register 'test/**/*.{ts,tsx}'",
        "lint": "tsc -p tsconfig.json --noEmit",
        "formatting:check": "prettier 'src/**/*.{ts,tsx,css}' 'test/**/*.{ts,tsx}' '*.json' -c",
        "formatting:write": "prettier 'src/**/*.{ts,tsx,css}' 'test/**/*.{ts,tsx}' '*.json' --write"
    },
    "peerDependencies": {
        "react": "^19.0.0"
    },
    "devDependencies": {
        "@types/chai": "^4.3.11",
        "@types/mocha": "^10.0.6",
        "@types/node": "^22.10.0",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "chai": "^4.3.10",
        "mocha": "^10.3.0",
        "prettier": "^2.8.8",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "ts-node": "^10.9.2",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "viem": "^2.37.5"
    }
}
